#!/bin/bash
# 用途：douyin2mp3 agent 的启停与自检入口（服务由 launchd 托管）。
set -euo pipefail

LABEL="com.yajun.douyin2mp3.agent"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PORT="${D2M_PORT:-8787}"
TOKEN_FILE="$HOME/.douyin2mp3/token"

usage() {
  cat <<'USAGE'
用法：d2m <命令>
  start    启动（或重启）后台服务
  stop     停止后台服务
  status   查看服务状态、配对信息与当前任务
  logs     跟随日志
  token    打印配对令牌
USAGE
}

case "${1:-status}" in
  start)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "已启动：$LABEL"
    ;;
  stop)
    launchctl bootout "gui/$(id -u)/$LABEL"
    echo "已停止：$LABEL"
    ;;
  status)
    launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | grep -E '^\s+(state|pid) =' || echo "服务未运行"
    if [ -f "$TOKEN_FILE" ]; then
      token="$(cat "$TOKEN_FILE")"
      for ip in $(ifconfig 2>/dev/null | awk '/inet /{print $2}' | grep -v '^127\.'); do
        echo "配对地址：http://$ip:$PORT"
      done
      curl -s "http://127.0.0.1:$PORT/v1/jobs" -H "authorization: Bearer $token" | head -c 600
      echo
    fi
    ;;
  logs)
    tail -f "$HOME/.douyin2mp3/agent.out.log" "$HOME/.douyin2mp3/agent.err.log"
    ;;
  token)
    cat "$TOKEN_FILE"
    ;;
  *)
    usage
    ;;
esac
